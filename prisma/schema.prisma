generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["aiverse_world"]
  url       = env("DATABASE_URL")   // Used for NestJS API requests (Pooler)
  directUrl = env("DIRECT_URL")  
}

model NewsSource {
  id                  String       @id @default(cuid())

  @@schema("aiverse_world")
  name                String       @unique
  type                String
  baseUrl             String
  isActive            Boolean      @default(true)
  pollIntervalMinutes Int          @default(15)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  rawArticles         RawArticle[]
}

model RawArticle {
  id            String      @id @default(cuid())
  sourceId      String
  externalId    String?
  title         String
  url           String      @unique
  content       String      @db.Text
  excerpt       String      @db.Text
  author        String?
  publishedAt   DateTime
  fetchedAt     DateTime    @default(now())
  contentHash   String
  status        String      @default("fetched")
  category      String?
  imageUrl      String?
  isDuplicate   Boolean     @default(false)
  duplicateOfId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  source        NewsSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  aiArticle     AiArticle?

  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([contentHash])
  @@index([status])
  @@schema("aiverse_world")
}

model AiArticle {
  id             String    @id @default(cuid())
  rawArticleId   String    @unique
  title          String
  slug           String
  summary        String    @db.Text
  keyPoints      Json
  category       String
  tags           Json?
  sourceUrl      String    @unique
  sourceName     String
  imageUrl       String
  publishedAt    DateTime
  processedAt    DateTime
  isPublished    Boolean   @default(true)
  copyrightOwner String
  summaryOnly    Boolean   @default(true)
  takedownEmail  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rawArticle     RawArticle @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)

  @@index([publishedAt(sort: Desc)])
  @@index([category])
  @@index([isPublished])
  @@schema("aiverse_world")
}

model NewsPipelineRun {
  id           String   @id @default(cuid())
  stage        String
  status       String
  trigger      String
  message      String?
  articleCount Int      @default(0)
  feedCount    Int      @default(0)
  metadata     Json?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@schema("aiverse_world")
}

model EnglishTutorSession {
  id            String             @id @default(cuid())
  userId        String?
  realtimeId    String?
  focus         String             @default("Daily conversation")
  provider      String             @default("openai-realtime")
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  averageScore  Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  turns         EnglishTutorTurn[]
  mistakes      EnglishTutorMistake[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@schema("aiverse_world")
}

model EnglishTutorTurn {
  id            String              @id @default(cuid())
  sessionId     String
  userId        String?
  userText      String              @db.Text
  tutorText     String              @db.Text
  correction    String?             @db.Text
  score         Int
  focus         String
  provider      String              @default("openai-realtime")
  createdAt     DateTime            @default(now())
  session       EnglishTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mistakes      EnglishTutorMistake[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("aiverse_world")
}

model EnglishTutorMistake {
  id          String              @id @default(cuid())
  sessionId   String
  turnId      String?
  userId      String?
  mistake     String
  correction  String
  category    String
  count       Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  session     EnglishTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn        EnglishTutorTurn?   @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([userId, category])
  @@index([sessionId])
  @@index([mistake])
  @@schema("aiverse_world")
}

model Problem {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  industry       String
  frequency      String
  painScore      Int
  email          String?
  aiSolvable     Int      @default(0)
  notAiSolvable  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([industry])
  @@index([painScore])
  @@schema("aiverse_world")
}

model AiToolSource {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String
  baseUrl     String?
  isActive    Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tools       AiTool[]

  @@schema("aiverse_world")
}

model AiTool {
  id                String   @id @default(cuid())
  sourceId          String?
  rank              Int?
  name              String
  slug              String   @unique
  category          String
  subcategory       String
  company           String
  website           String
  domain            String
  favicon           String
  logoUrl           String?
  freePlan          String
  freeTrial         Boolean  @default(false)
  pricingModel      String
  startingPriceUsd  Float?
  pricingNotes      String?
  shortDescription  String   @db.Text
  summary           String?  @db.Text
  features          Json
  bestFor           Json
  targetAudience    Json
  tags              Json
  aiType            Json
  modalities        Json
  modelProvider     Json
  modelNames        Json?
  apiAvailable      Boolean  @default(false)
  openSource        Boolean  @default(false)
  deploymentType    Json
  platforms         Json
  integrations      Json?
  teamCollaboration Boolean?
  security          Json?
  privacyNotes      String?  @db.Text
  popularityScore   Int?
  rating            Float?
  reviewCount       Int?
  status            String   @default("Active")
  launchYear        Int?
  lastVerified      DateTime?
  sourceUrl         String
  sourceType        String
  searchText        String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  source            AiToolSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  embeddings        AiToolEmbedding[]

  @@index([category])
  @@index([pricingModel])
  @@index([popularityScore])
  @@index([rating])
  @@index([updatedAt(sort: Desc)])
  @@schema("aiverse_world")
}

model AiToolEmbedding {
  id              String   @id @default(cuid())
  toolId          String
  chunkIndex      Int
  content         String   @db.Text
  contentHash     String
  embedding       Json
  embeddingModel  String
  metadata        Json?
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tool            AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, chunkIndex])
  @@index([toolId])
  @@index([contentHash])
  @@index([updatedAt(sort: Desc)])
  @@schema("aiverse_world")
}
