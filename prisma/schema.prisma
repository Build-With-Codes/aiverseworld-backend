generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["aiverse_world"]
}

model NewsSource {
  id                  String       @id @default(cuid())

  @@schema("aiverse_world")
  name                String       @unique
  type                String
  baseUrl             String
  isActive            Boolean      @default(true)
  pollIntervalMinutes Int          @default(15)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  rawArticles         RawArticle[]
}

model RawArticle {
  id            String      @id @default(cuid())
  sourceId      String
  externalId    String?
  title         String
  url           String      @unique
  content       String      @db.Text
  excerpt       String      @db.Text
  author        String?
  publishedAt   DateTime
  fetchedAt     DateTime    @default(now())
  contentHash   String
  status        String      @default("fetched")
  category      String?
  imageUrl      String?
  isDuplicate   Boolean     @default(false)
  duplicateOfId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  source        NewsSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  aiArticle     AiArticle?

  @@index([sourceId, publishedAt(sort: Desc)])
  @@index([contentHash])
  @@index([status])
  @@schema("aiverse_world")
}

model AiArticle {
  id             String    @id @default(cuid())
  rawArticleId   String    @unique
  title          String
  slug           String
  summary        String    @db.Text
  keyPoints      Json
  category       String
  tags           Json?
  sourceUrl      String    @unique
  sourceName     String
  imageUrl       String
  publishedAt    DateTime
  processedAt    DateTime
  isPublished    Boolean   @default(true)
  copyrightOwner String
  summaryOnly    Boolean   @default(true)
  takedownEmail  String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  rawArticle     RawArticle @relation(fields: [rawArticleId], references: [id], onDelete: Cascade)

  @@index([publishedAt(sort: Desc)])
  @@index([category])
  @@index([isPublished])
  @@schema("aiverse_world")
}

model NewsPipelineRun {
  id           String   @id @default(cuid())
  stage        String
  status       String
  trigger      String
  message      String?
  articleCount Int      @default(0)
  feedCount    Int      @default(0)
  metadata     Json?
  startedAt    DateTime @default(now())
  finishedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([status])
  @@schema("aiverse_world")
}

model EnglishTutorSession {
  id            String             @id @default(cuid())
  userId        String?
  realtimeId    String?
  focus         String             @default("Daily conversation")
  provider      String             @default("openai-realtime")
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  averageScore  Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  turns         EnglishTutorTurn[]
  mistakes      EnglishTutorMistake[]

  @@index([userId, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
  @@schema("aiverse_world")
}

model EnglishTutorTurn {
  id            String              @id @default(cuid())
  sessionId     String
  userId        String?
  userText      String              @db.Text
  tutorText     String              @db.Text
  correction    String?             @db.Text
  score         Int
  focus         String
  provider      String              @default("openai-realtime")
  createdAt     DateTime            @default(now())
  session       EnglishTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  mistakes      EnglishTutorMistake[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt(sort: Desc)])
  @@schema("aiverse_world")
}

model EnglishTutorMistake {
  id          String              @id @default(cuid())
  sessionId   String
  turnId      String?
  userId      String?
  mistake     String
  correction  String
  category    String
  count       Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  session     EnglishTutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turn        EnglishTutorTurn?   @relation(fields: [turnId], references: [id], onDelete: SetNull)

  @@index([userId, category])
  @@index([sessionId])
  @@index([mistake])
  @@schema("aiverse_world")
}

model Problem {
  id             String   @id @default(cuid())
  title          String
  description    String   @db.Text
  industry       String
  frequency      String
  painScore      Int
  email          String?
  aiSolvable     Int      @default(0)
  notAiSolvable  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([createdAt(sort: Desc)])
  @@index([industry])
  @@index([painScore])
  @@schema("aiverse_world")
}

model AiToolSource {
  id          String   @id @default(cuid())
  name        String   @unique
  type        String
  baseUrl     String?
  isActive    Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tools       AiTool[]

  @@schema("aiverse_world")
}

model AiTool {
  id                String   @id @default(cuid())
  sourceId          String?
  rank              Int?
  name              String
  slug              String   @unique
  category          String
  subcategory       String
  company           String
  website           String
  domain            String
  favicon           String
  logoUrl           String?
  freePlan          String
  freeTrial         Boolean  @default(false)
  pricingModel      String
  startingPriceUsd  Float?
  pricingNotes      String?
  shortDescription  String   @db.Text
  summary           String?  @db.Text
  features          Json
  bestFor           Json
  targetAudience    Json
  tags              Json
  aiType            Json
  modalities        Json
  modelProvider     Json
  modelNames        Json?
  apiAvailable      Boolean  @default(false)
  openSource        Boolean  @default(false)
  deploymentType    Json
  platforms         Json
  integrations      Json?
  teamCollaboration Boolean?
  security          Json?
  privacyNotes      String?  @db.Text
  popularityScore   Int?
  rating            Float?
  reviewCount       Int?
  status            String   @default("Active")
  launchYear        Int?
  lastVerified      DateTime?
  sourceUrl         String
  sourceType        String
  prosJson          Json?
  consJson          Json?
  editorialVerdict  String?  @db.Text
  alternativesNote  String?  @db.Text
  faqsJson          Json?
  featureNotesJson  Json?
  searchText        String   @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  source            AiToolSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  embeddings        AiToolEmbedding[]

  @@index([category])
  @@index([pricingModel])
  @@index([popularityScore])
  @@index([rating])
  @@index([updatedAt(sort: Desc)])
  @@schema("aiverse_world")
}

model AiToolEmbedding {
  id              String   @id @default(cuid())
  toolId          String
  chunkIndex      Int
  content         String   @db.Text
  contentHash     String
  embedding       Json
  embeddingModel  String
  metadata        Json?
  sourceUpdatedAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tool            AiTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, chunkIndex])
  @@index([toolId])
  @@index([contentHash])
  @@index([updatedAt(sort: Desc)])
  @@schema("aiverse_world")
}

// ── Engagement & retention ──────────────────────────────────────────────
// userId is the auth-service AuthUser.id (aiverse_auth schema), stored as a
// plain string — intentionally NOT a cross-schema foreign key. anonId is a
// client-generated stable id for anonymous attribution.

model ToolEvent {
  id        String   @id @default(cuid())
  toolId    String?
  userId    String?
  anonId    String?
  type      String // view | save | unsave | compare | search | click
  query     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt(sort: Desc)])
  @@index([toolId, type])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([anonId, type, createdAt(sort: Desc)])
  @@schema("aiverse_world")
}

model ToolStat {
  toolId        String   @id
  viewsTotal    Int      @default(0)
  views7d       Int      @default(0)
  views30d      Int      @default(0)
  savesTotal    Int      @default(0)
  comparesTotal Int      @default(0)
  searchHits    Int      @default(0)
  trendingScore Float    @default(0)
  updatedAt     DateTime @updatedAt

  @@index([trendingScore(sort: Desc)])
  @@index([savesTotal(sort: Desc)])
  @@index([comparesTotal(sort: Desc)])
  @@schema("aiverse_world")
}

model SavedTool {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([toolId])
  @@schema("aiverse_world")
}

model FollowedCategory {
  id        String   @id @default(cuid())
  userId    String
  category  String
  createdAt DateTime @default(now())

  @@unique([userId, category])
  @@index([userId])
  @@schema("aiverse_world")
}

// Central media library — one record per asset, referenced by blogs, tools,
// categories, collections, authors. Stored in Cloudflare R2 (or local fallback).
model Media {
  id           String   @id @default(cuid())
  filename     String
  url          String // public URL (R2 public bucket or local /uploads)
  storageKey   String? // object key in R2 (null when local)
  mimeType     String
  format       String // webp | avif | png | jpeg ...
  width        Int?
  height       Int?
  size         Int? // bytes
  altText      String?
  caption      String?
  credit       String?
  license      String?
  blurDataUrl  String?  @db.Text // base64 blur placeholder for next/image
  sourceUrl    String? // original URL when ingested from the web
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  coverForPosts BlogPost[] @relation("BlogCover")

  @@index([createdAt(sort: Desc)])
  @@schema("aiverse_world")
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  description     String    @db.Text
  content         String    @db.Text // rich HTML: headings, images, links, tables
  contentBlocks   Json?     // forward-compat: block-based content (image blocks, etc.)
  category        String
  tags            Json?
  author          String
  coverImage      String?   // legacy plain URL (kept for backward compat)
  coverMediaId    String?
  coverMedia      Media?    @relation("BlogCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  galleryJson     Json?     // array of media ids / structured image refs
  seoTitle        String?
  metaDescription String?   @db.Text
  readTime        String    @default("5 min")
  themeJson       Json?
  featured        Boolean   @default(false)
  published       Boolean   @default(true)
  publishedAt     DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published, publishedAt(sort: Desc)])
  @@index([category])
  @@index([featured])
  @@index([coverMediaId])
  @@schema("aiverse_world")
}

// User-submitted tool reviews. toolId/userId are plain strings (matching the
// SavedTool/ToolEvent convention) — userId is the auth-service AuthUser.id,
// not a cross-schema FK.
model Review {
  id          String   @id @default(cuid())
  toolId      String
  userId      String
  authorName  String
  authorEmail String
  authorImage String?
  rating      Int // 1-5
  comment     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, toolId])
  @@index([toolId, createdAt(sort: Desc)])
  @@schema("aiverse_world")
}
